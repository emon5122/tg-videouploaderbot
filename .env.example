BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_chat_id_here
VIDEO_PATH=path/to/your/videos
MAX_FILE_SIZE_MB=50
CONCURRENT_UPLOADS=1
UPLOAD_DELAY=3.0

# MAX_FILE_SIZE_MB controls the threshold:
# Files <= 50MB: sent as video (with preview)
# Files > 50MB and <= 2000MB: sent as document
# Files > 2000MB: skipped (Telegram's 2GB limit)

# CONCURRENT_UPLOADS: Number of simultaneous uploads (1 recommended to avoid flood control)
# UPLOAD_DELAY: Seconds to wait between uploads (3.0 recommended)
